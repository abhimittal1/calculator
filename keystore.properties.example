# =============================================================================
# keystore.properties.example
# =============================================================================
#
# Copy this file to  android/keystore.properties  and fill in your real values.
# NEVER commit android/keystore.properties to version control!
#
# HOW TO GENERATE A RELEASE KEYSTORE
# ------------------------------------
# Run this command (requires JDK 17 on PATH):
#
#   keytool -genkey -v \
#     -keystore android/app/release.keystore \
#     -alias calculator-key \
#     -keyalg RSA -keysize 2048 \
#     -validity 10000
#
# You will be prompted for a Distinguished Name (your name, organisation, etc.)
# and two passwords (keystore + key). Use the same values below.
#
# IMPORTANT — Back up your keystore file somewhere safe!
# If you lose it you cannot publish updates to an existing Play Store listing.
# =============================================================================

storeFile=app/release.keystore
storePassword=your_keystore_password_here
keyAlias=calculator-key
keyPassword=your_key_password_here
